rules_version = '2';
// Footing keeps no server-side data: the shared result cache (spec cut #1) was not built, because a cache hit would
// skip the on-device → cloud path the app exists to show, and a public write surface invites poisoned verdicts.
// Everything is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
